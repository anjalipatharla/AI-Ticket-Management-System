# Copy this file to .env and replace each placeholder.
# Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-private-django-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=TMS
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id

# Local development: reset email is printed in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# SMTP example values (use when EMAIL_BACKEND is set to
# django.core.mail.backends.smtp.EmailBackend).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
